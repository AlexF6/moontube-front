{
  "version": 2,
  "buildCommand": "pnpm ng build --configuration production",
  "outputDirectory": "dist/moontube/browser",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://tags-slope-innovations-gazette.trycloudflare.com/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}